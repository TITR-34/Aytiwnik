# ===== BACKEND (apps/api) — Render Web Service env vars =====
PORT=8080
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase > Project Settings > API > service_role (GİZLİ!)
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=                # 503 olanda keçiləcək ehtiyat model (AI Studio siyahısından)
GROQ_API_KEY=                         # ehtiyat: yalnız mətn üçün (ixtiyari)
GROQ_MODEL=
CORS_ORIGINS=http://localhost:5173    # production-da frontend URL-i (vergüllə ayır)
AI_GRADING_LIMIT_PER_EXAM=5           # hər istifadəçi, hər imtahan üçün AI yoxlama sayı
AI_EXTRACTION_LIMIT_PER_DAY=10        # hər istifadəçi üçün gündəlik fayldan sual çıxarma

# ===== FRONTEND (apps/web) — Render Static Site env vars =====
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=               # Supabase > Project Settings > API > anon public
VITE_API_URL=http://localhost:8080    # production-da backend URL-i
